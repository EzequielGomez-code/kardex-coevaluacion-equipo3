# Plantilla de variables de entorno de Kardex.
# Copie este archivo como .env y complete los valores. NUNCA escriba
# credenciales reales aquí: este sí se versiona (Seguridad #5 del brief).

# Módulo de ajustes: config.settings.local | config.settings.produccion
DJANGO_SETTINGS_MODULE=

# Clave secreta de Django. Genérela con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=

# True solo en desarrollo. En producción SIEMPRE False.
DJANGO_DEBUG=

# Hosts permitidos, separados por coma. Ej: kardex.onrender.com
ALLOWED_HOSTS=

# Orígenes de confianza para CSRF, separados por coma. Ej: https://kardex.onrender.com
CSRF_TRUSTED_ORIGINS=

# Cadena de conexión. Vacío = SQLite local.
# Neon: postgresql://USUARIO:CLAVE@HOST/BASE?sslmode=require
DATABASE_URL=

# Contraseña del administrador inicial que crea "manage.py sembrar".
DJANGO_ADMIN_PASSWORD=

# Zona horaria del sistema.
TIME_ZONE=America/Santo_Domingo

# Tamaño máximo de archivo subido, en megabytes (Seguridad #11).
TAMANO_MAXIMO_ARCHIVO_MB=5
